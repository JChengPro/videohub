# 复制为服务器上的 .env 后修改。不要将真实 .env 提交到 Git。
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_password
MYSQL_DATABASE=videohub
REDIS_PASSWORD=CHANGE_ME_redis_password
RABBITMQ_USERNAME=videohub
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
JWT_SECRET=CHANGE_ME_use_a_long_random_jwt_secret

# 默认使用 Docker 数据卷保存本地上传文件。
STORAGE_TYPE=local

# 使用私有阿里云 OSS 时再填写以下配置。
OSS_ENDPOINT=
OSS_REGION=

OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
